# FinMitra Environment Configuration

# Google Gemini API Key (Optional: system falls back to MockAIProvider if not set)
GEMINI_API_KEY=your_gemini_api_key_here

# Market Data Configuration (Optional: default is yfinance with Mock Market Data fallback)
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_API_KEY=

# RAG Configuration
RAG_VECTOR_STORE_PATH=./data/vectorstore
RAG_COLLECTION_NAME=finmitra_knowledge
RAG_TOP_K=5
RAG_RERANK_TOP_K=3
RAG_EMBEDDING_MODEL=local_tfidf_hashing

# Server Configuration
HOST=0.0.0.0
PORT=8000
